@startuml
class Hero {
    - name: String
    - health: int
    - Mana: int
    - class: String
    - level: int
    - gold: int
    - experience: int
    + attack(): int
    + defend(damage: int): void
    + levelUp(): void
    + GetExperience(exp: int): void
    + GetGold(amount: int): void
}

'Order' <|-- Hero : +5 Mana
'Order' <|-- Hero : +2 Defense
'Order' <|-- Hero : Heals/Shields
'Chaos' <|-- Hero : +3 Attack
'Chaos' <|-- Hero : +5 HP
'Chaos' <|-- Hero : Fireball/Lightning
'Warrior' <|-- Hero : +2 Attack
'Warrior' <|-- Hero : +3 Defense
'Warrior' <|-- Hero : Cleave/PHYSICAL
'Mage' <|-- Hero : +5 Mana
'Mage' <|-- Hero : +1 Attack
'Mage' <|-- Hero : Mana Replenish
@enduml