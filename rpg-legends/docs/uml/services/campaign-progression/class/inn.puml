@startuml

' ─────────────────────────────────────────────
' Domain — Core entities
' ─────────────────────────────────────────────
package "Domain" {

    class HeroState {
        - name: String
        - curHp: int
        - maxHp: int
        - specialization: String
        - curMana: int
        - maxMana: int
        - level: int
        - mageLvl: int
        - warriorLvl: int
        - orderLvl: int
        - chaosLvl: int
        - curExp: int
        - lvlUpExp: int
        - defense: int
        - attack: int
        - ability: ArrayList<String>
        + gainExp(expGained: int): int
        + maxRestore(): void
        + getName(): String
        + setName(name: String): void
        + getLevel(): int
        + getCurHp(): int
        + setCurHp(curHp: int): void
        + gainCurHp(amount: int): void
        + minusCurHp(amount: int): void
        + getMaxHp(): int
        + getCurMana(): int
        + gainCurMana(amount: int): void
        + minusCurMana(amount: int): void
        + getMaxMana(): int
        + getDefense(): int
        + getAttack(): int
        + getAbility(): ArrayList<String>
    }

    class Enemy {
        - level: int
        - health: int
        - attack: int
        - defense: int
        + getLevel(): int
        + getHealth(): int
        + getAttack(): int
        + getDefense(): int
        + getHp(): int
    }

    class Item {
        - type: ItemType
        + getName(): String
        + getCost(): int
        + getHpHeal(): int
        + getManaHeal(): int
        + canRevive(): boolean
    }

    enum ItemType {
        BREAD
        CHEESE
        STEAK
        WATER
        JUICE
        WINE
        EXILIR
    }

    class Score {
        - score: int
        + calculateScore(goldSpent: int, totalLevels: int, extraGold: int): int
        + getScore(): int
    }

    interface ScoreStats {
        + getScore(): int
    }

    Item --> ItemType
    Score ..|> ScoreStats
}

' ─────────────────────────────────────────────
' Domain — Services
' ─────────────────────────────────────────────
package "Domain Services" {

    class PartyService {
        - partyMembers: List<HeroState>
        + addHero(hero: HeroState): void
        + getParty(): List<HeroState>
        + hasSpace(): boolean
        + isDefeated(): boolean
        + levelUp(exp: int): void
        + maxRestore(): void
        + maxRestoreWithStatus(): List<RestoreStatus>
        + getTotalLevels(): int
    }

    class InventoryService {
        - gold: int
        - goldSpent: int
        - items: int[]
        + addItem(type: ItemType, amount: int): void
        + useItem(type: ItemType, amount: int): void
        + gainGold(amount: int): void
        + canAfford(amount: int): boolean
        + getGold(): int
        + getItemCount(type: ItemType): int
    }

    class EnemyFactory {
        - random: Random
        + createEnemies(partyTotalLevel: int): List<Enemy>
        - distributeLevels(totalLevel: int, count: int): List<Integer>
        - createScaledEnemy(level: int): Enemy
    }

    PartyService --> HeroState
    InventoryService --> ItemType
    EnemyFactory --> Enemy : creates
}

' ─────────────────────────────────────────────
' Domain — Rooms
' ─────────────────────────────────────────────
package "Rooms" {

    interface Room

    class BattleRoom {
        - enemies: List<Enemy>
        + BattleRoom()
        + addEnemies(enemies: List<Enemy>)
        + getEnemies(): List<Enemy>
        + getExp(): int
        + getGold(): int
        + setTurnOrder(allies: List<HeroState>, enemies: List<Enemy>)
        + intialize(partyService: PartyService)
    }

    class Inn {
        - MAX_PARTY_SIZE: int
        - CLASSES: String[]
        - shop: List<ItemType>
        - recruits: Map<String, HeroState>
        + generateRecruit(partyService: PartyService, roomCounter: int): Optional<HeroState>
        + viewRecruits(): Map<String, HeroState>
        + hasRecruit(name: String): boolean
        + getShop(): List<ItemType>
        + addRecruit(hero: HeroState)
    }

    BattleRoom ..|> Room
    Inn ..|> Room
    BattleRoom --> "0..*" Enemy
    Inn --> "0..*" HeroState : manages
    Inn --> "0..*" ItemType : sells
    Inn ..> PartyService : uses
}

' ─────────────────────────────────────────────
' Domain — Campaign Management
' ─────────────────────────────────────────────
package "Campaign Management" {

    class CampaignManager {
        - currentRoom: Room
        - battleChance: double
        - roomCounter: int
        - endOfRoom: boolean
        - RoomFactory: RoomFactory
        - MAX_ROOMS: int = 30
        + CampaignManager(RoomFactory)
        + startNewCampaign()
        + isEndOfRoom(): boolean
        + setEndOfRoom(value: boolean)
        + getBattleChance(): double
        + setBattleChance(value: double)
        + getRoomCounter(): int
        + getCurrentRoom(): Room
        + nextRoom(): Room
    }

    interface CampaignSnapshot {
        + getRoomCounter(): int
        + setRoomCounter(roomCounter: int)
        + getBattleChance(): double
        + setBattleChance(chance: double)
        + getCurRoom(): String
        + setCurRoom(room: String)
        + getGold(): int
        + setGold(gold: int)
        + getExp(): int
        + setExp(exp: int)
        + getParty(): List<HeroState>
        + setParty(party: List<HeroState>)
        + getItems(): int[]
        + setItems(items: int[])
    }

    class CampaignSnapshotImpl {
        - roomCounter: int
        - battleChance: double
        - curRoom: String
        - gold: int
        - exp: int
        - party: List<HeroState>
        - items: int[]
        + getRoomCounter(): int
        + setRoomCounter(roomCounter: int)
        + getBattleChance(): double
        + setBattleChance(chance: double)
        + getCurRoom(): String
        + setCurRoom(room: String)
        + getGold(): int
        + setGold(gold: int)
        + getExp(): int
        + setExp(exp: int)
        + getParty(): List<HeroState>
        + setParty(party: List<HeroState>)
        + getItems(): int[]
        + setItems(items: int[])
    }

    class CampaignStateManager {
        - campaignManager: CampaignManager
        - partyService: PartyService
        - InventoryService: InventoryService
        + createSnapshot(): CampaignSnapshot
        + loadFromSnapshot(snapshot: CampaignSnapshot)
    }

    CampaignSnapshotImpl ..|> CampaignSnapshot
    CampaignStateManager --> CampaignManager
    CampaignStateManager --> PartyService
    CampaignStateManager --> InventoryService
    CampaignStateManager ..> CampaignSnapshot
    CampaignManager --> Room
}

' ─────────────────────────────────────────────
' Application — Use Cases
' ─────────────────────────────────────────────
package "Application Use Cases" {

    class StartCampaignUseCase {
        + execute(startingHeroDTO: HeroInstanceDTO): StartCampaignDTO
        - mapToDomain(dto: HeroInstanceDTO): HeroState
    }

    class LoadCampaignUseCase {
        + execute(snapshotDTO: CampaignSnapshotDTO): LoadCampaignDTO
        - toDomainHero(dto: HeroInstanceDTO): HeroState
    }

    class ExitCampaignUseCase {
        + execute(): CampaignSnapshotDTO
    }

    class EndCampaignUseCase {
        + execute(): CampaignEndDTO
    }

    class SaveCampaignToPvpUseCase {
        - pvpUrl: String
        + execute(): CampaignEndDTO
    }

    class NextRoomUseCase {
        + execute(): NextRoomDTO
    }

    class InnInitializeUseCase {
        + execute(): InnInitializeResponseDTO
    }

    class GetPartyUseCase {
        + execute(): List<HeroInstanceDTO>
    }

    class GetInventoryUseCase {
        + execute(): List<ItemDTO>
    }

    class GetShopUseCase {
        + execute(): GetShopResponseDTO
    }

    class ViewRecruitUseCase {
        + execute(): List<RecruitDTO>
    }

    class BuyItemUseCase {
        + execute(type: ItemType, amount: int): BuyItemResponseDTO
        + execute(type: ItemType): BuyItemResponseDTO
    }

    class BuyRecruitUseCase {
        + execute(roomCounter: int): BuyRecruitResponseDTO
    }

    class ItemConsumeUseCase {
        + execute(itemType: ItemType, heroIndex: int): ItemConsumeResponseDTO
    }

    class GenerateBattleRoomUseCase {
        + execute(): BattleRoomResponseDTO
    }

    class InitializeBattleUseCase {
        - battleLibUrl: String
        + execute(): BattleRoomResponseDTO
    }

    class GainExpUseCase {
        + execute(totalExp: int): List<HeroExpDTO>
    }

    class GainGoldUseCase {
        + execute(amount: int): GoldDTO
    }

    SaveCampaignToPvpUseCase --> EndCampaignUseCase
    InitializeBattleUseCase --> GenerateBattleRoomUseCase
}

' ─────────────────────────────────────────────
' Application → Domain dependencies
' ─────────────────────────────────────────────
StartCampaignUseCase --> CampaignManager
StartCampaignUseCase --> PartyService
StartCampaignUseCase --> InventoryService
StartCampaignUseCase --> HeroState : creates

LoadCampaignUseCase --> CampaignManager
LoadCampaignUseCase --> PartyService
LoadCampaignUseCase --> InventoryService
LoadCampaignUseCase --> HeroState : creates

ExitCampaignUseCase --> CampaignManager
ExitCampaignUseCase --> PartyService
ExitCampaignUseCase --> InventoryService

EndCampaignUseCase --> PartyService
EndCampaignUseCase --> InventoryService
EndCampaignUseCase --> Score

NextRoomUseCase --> CampaignManager

InnInitializeUseCase --> PartyService

GetPartyUseCase --> PartyService

GetInventoryUseCase --> InventoryService

GetShopUseCase --> Inn

ViewRecruitUseCase --> Inn

BuyItemUseCase --> Inn
BuyItemUseCase --> InventoryService

BuyRecruitUseCase --> Inn
BuyRecruitUseCase --> PartyService
BuyRecruitUseCase --> InventoryService

ItemConsumeUseCase --> InventoryService
ItemConsumeUseCase --> PartyService
ItemConsumeUseCase --> CampaignManager

GenerateBattleRoomUseCase --> PartyService
GenerateBattleRoomUseCase --> EnemyFactory

GainExpUseCase --> PartyService

GainGoldUseCase --> InventoryService

' ─────────────────────────────────────────────
' Presentation — Controller
' ─────────────────────────────────────────────
package "Presentation" {

    class CampaignController {
        + startCampaign(initialHero: HeroInstanceDTO): StartCampaignDTO
        + loadCampaign(snapshot: CampaignSnapshotDTO): LoadCampaignDTO
        + exitCampaign(): CampaignSnapshotDTO
        + nextRoom(): Object
        + getParty(): List<HeroInstanceDTO>
        + getInventory(): List<ItemDTO>
        + buyItem(request: BuyItemRequestDTO): BuyItemResponseDTO
        + buyRecruit(request: BuyRecruitRequestDTO): BuyRecruitResponseDTO
        + generateBattle(): BattleRoomResponseDTO
        + getShop(): GetShopResponseDTO
        + innInitialize(): InnInitializeResponseDTO
        + useItem(request: ItemConsumeRequestDTO): ItemConsumeResponseDTO
        + viewRecruits(): List<RecruitDTO>
        + initializeBattle(): BattleRoomResponseDTO
        + saveCampaign(): CampaignEndDTO
        + gainExp(exp: int): List<HeroExpDTO>
        + gainGold(amount: int): GoldDTO
    }

    CampaignController --> StartCampaignUseCase
    CampaignController --> LoadCampaignUseCase
    CampaignController --> ExitCampaignUseCase
    CampaignController --> EndCampaignUseCase
    CampaignController --> NextRoomUseCase
    CampaignController --> GetPartyUseCase
    CampaignController --> GetInventoryUseCase
    CampaignController --> BuyItemUseCase
    CampaignController --> BuyRecruitUseCase
    CampaignController --> GenerateBattleRoomUseCase
    CampaignController --> GetShopUseCase
    CampaignController --> InnInitializeUseCase
    CampaignController --> ItemConsumeUseCase
    CampaignController --> ViewRecruitUseCase
    CampaignController --> InitializeBattleUseCase
    CampaignController --> SaveCampaignToPvpUseCase
    CampaignController --> GainExpUseCase
    CampaignController --> GainGoldUseCase
}

@enduml