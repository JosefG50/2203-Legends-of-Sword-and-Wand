@startuml

skinparam classAttributeIconSize 0

package "Combat Library" {

  interface Action {
    + getActor() : Unit
    + getName() : String
    + canExecute(state : BattleState) : boolean
    + execute(state : BattleState) : void
  }

  class BattleEngine {
    state : BattleState
    turnManager : TurnManager
    phase : BattlePhase
    + BattleEngine(state : BattleState, turnManager : TurnManager)
    + setPhase(phase : BattlePhase) : void
    + update() : void
    + step(action : Action) : void
    + isBattleOver() : boolean
    + resolveIfOver() : BattleResult
    + getState() : BattleState
  }

  interface BattlePhase {
    + handle(engine : BattleEngine) : void
  }

  class SelectingActionPhase {
    + handle(engine : BattleEngine) : void
  }

  class ResolvingActionPhase {
    + handle(engine : BattleEngine) : void
  }

  class CheckingEndPhase {
    + handle(engine : BattleEngine) : void
  }

  class BattleOverPhase {
    + handle(engine : BattleEngine) : void
  }

  class BattleState {
    allies : List<Unit>
    enemies : List<Unit>
    + BattleState(allies : List<Unit>, enemies : List<Unit>)
    + getAllies() : List<Unit>
    + getEnemies() : List<Unit>
    + getAllUnits() : List<Unit>
    + isTeamDefeated(team : String) : boolean
    + removeDead() : void
  }

  class BattleResult {
    victoryForAllies : boolean
    survivorsAllies : List<Unit>
    survivorsEnemies : List<Unit>
    summary : String
    + BattleResult(victoryForAllies : boolean, survivorsAllies : List<Unit>, survivorsEnemies : List<Unit>, summary : String)
    + isVictoryForAllies() : boolean
    + getSurvivorsAllies() : List<Unit>
    + getSurvivorsEnemies() : List<Unit>
    + getSummary() : String
  }

  class TurnManager {
    queue : TurnQueue
    + TurnManager(queue : TurnQueue)
    + initialize(allies : List<Unit>, enemies : List<Unit>) : void
    + nextUnit() : Unit
    + registerWait(unit : Unit) : void
    + endTurn(unit : Unit) : void
    + getPlannedOrder() : List<Unit>
  }

  class TurnQueue {
    ready : Deque<Unit>
    waiting : Deque<Unit>
    + rebuildFromUnits(units : List<Unit>) : void
    + pollNext() : Unit
    + pushToEnd(unit : Unit) : void
    + enqueueWait(unit : Unit) : void
    + flushWaiters() : void
    + peekOrder() : List<Unit>
    + isEmpty() : boolean
  }

  class Unit {
    name : String
    stats : Stats
    effects : List<StatusEffect>
    + Unit(name : String, stats : Stats)
    + isAlive() : boolean
    + isStunned() : boolean
    + onTurnStart() : void
    + onTurnEnd() : void
    + applyDamage(amount : int) : void
    + heal(amount : int) : void
    + restoreMana(amount : int) : void
    + spendMana(cost : int) : boolean
    + addStatusEffect(effect : StatusEffect) : void
    + removeExpiredEffects() : void
    + getStats() : Stats
  }

  class Stats {
    level : int
    attack : int
    defense : int
    hp : int
    maxHp : int
    mana : int
    maxMana : int
    + Stats(level : int, attack : int, defense : int, hp : int, maxHp : int, mana : int, maxMana : int)
    + getAttack() : int
    + getDefense() : int
    + getHp() : int
    + getMana() : int
    + modifyHp(delta : int) : void
    + modifyMana(delta : int) : void
    + computeDamageAgainst(defender : Stats) : int
  }

  abstract class StatusEffect {
    remainingTurns : int
    + StatusEffect(remainingTurns : int)
    + onApply(unit : Unit) : void
    + onTurnStart(unit : Unit) : void
    + onTurnEnd(unit : Unit) : void
    + tick() : void
    + isExpired() : boolean
  }

  class StunEffect {
    + StunEffect(remainingTurns : int)
    + blocksAction() : boolean
  }

  class AttackAction {
    actor : Unit
    target : Unit
    + AttackAction(actor : Unit, target : Unit)
    + getActor() : Unit
    + getName() : String
    + canExecute(state : BattleState) : boolean
    + execute(state : BattleState) : void
    + getTarget() : Unit
  }

  class DefendAction {
    actor : Unit
    + DefendAction(actor : Unit)
    + getActor() : Unit
    + getName() : String
    + canExecute(state : BattleState) : boolean
    + execute(state : BattleState) : void
  }

  class WaitAction {
    actor : Unit
    + WaitAction(actor : Unit)
    + getActor() : Unit
    + getName() : String
    + canExecute(state : BattleState) : boolean
    + execute(state : BattleState) : void
  }

  class CastAction {
    actor : Unit
    abilityName : String
    manaCost : int
    targets : List<Unit>
    + CastAction(actor : Unit, abilityName : String, manaCost : int, targets : List<Unit>)
    + getActor() : Unit
    + getName() : String
    + canExecute(state : BattleState) : boolean
    + execute(state : BattleState) : void
    + getTargets() : List<Unit>
  }

  interface ActionFactory {
    + createAttack(actor : Unit, target : Unit) : Action
    + createDefend(actor : Unit) : Action
    + createWait(actor : Unit) : Action
    + createCast(actor : Unit, abilityName : String, manaCost : int, targets : List<Unit>) : Action
  }

}

Action <|.. AttackAction
Action <|.. DefendAction
Action <|.. WaitAction
Action <|.. CastAction

StatusEffect <|.. StunEffect

BattlePhase <|.. SelectingActionPhase
BattlePhase <|.. ResolvingActionPhase
BattlePhase <|.. CheckingEndPhase
BattlePhase <|.. BattleOverPhase

BattleEngine o-- BattleState
BattleEngine ..> TurnManager : uses
BattleEngine ..> Action : executes
BattleEngine ..> BattlePhase : current

TurnManager o-- TurnQueue
TurnQueue ..> Unit : queue
Unit o-- Stats
Unit o-- "0..*" StatusEffect

@enduml
